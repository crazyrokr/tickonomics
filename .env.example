# Tickonomics Environment Configuration
# Copy to .env and fill in values before running docker compose

# --- TimescaleDB ---
POSTGRES_PASSWORD=tickonomics

# --- Monitoring ---
# Generate a strong password: openssl rand -base64 24
GRAFANA_PASSWORD=

# --- External API Keys (all free tiers) ---
FRED_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Spring Boot Overrides ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://timescaledb:5432/tickonomics
# SPRING_DATASOURCE_USERNAME=tickonomics
# SPRING_DATASOURCE_PASSWORD=tickonomics

# --- Analytics Worker ---
# ANALYTICS_WORKER_URL=http://analytics-worker:8001

# --- OpenTelemetry ---
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://jaeger:4317

# --- Demo Mode ---
# MONITOR_DEMO_ENABLED=false
# MONITOR_DEMO_VIRTUAL_BALANCE=100000
# MONITOR_DEMO_AUTO_EXECUTE_SIGNALS=false
