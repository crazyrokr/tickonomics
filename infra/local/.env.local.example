# Tickonomics local server secrets.
# Copy to .env.local (same directory) and fill in. Sourced by docker-compose.local.yml.
# chmod 600 .env.local — never commit.

# Required: TimescaleDB superuser password
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# v6 free data sources (ADR-012). Leave blank to run with sources that need no key.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=

# Optional: Grafana admin password (default: admin)
GRAFANA_PASSWORD=
