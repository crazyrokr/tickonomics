#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

mkdir -p /opt/tickonomics/scripts /opt/tickonomics/results

cat > /opt/tickonomics/docker-compose.forecast.yml << 'COMPOSE_EOF'
%{ if registry_url != "" }
services:
  backend:
    image: "${backend_image}"
    ports:
      - "8080:8080"
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://timescaledb:5432/tickonomics
      SPRING_DATASOURCE_USERNAME: tickonomics
      SPRING_DATASOURCE_PASSWORD: "${postgres_password}"
      ANALYTICS_WORKER_URL: http://analytics-worker:8001
      MANAGEMENT_OTLP_TRACING_ENDPOINT: ""
      MANAGEMENT_TRACING_SAMPLING_PROBABILITY: "0"
      POLYGON_API_KEY: "${polygon_api_key}"
      FRED_API_KEY: "${fred_api_key}"
      AUTH_DISABLED: "true"
      SERVER_SHUTDOWN: graceful
      SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE: 60s
    depends_on:
      timescaledb:
        condition: service_healthy
      analytics-worker:
        condition: service_healthy
    networks:
      - tickonomics-net
    volumes:
      - ingestion_overflow:/data/overflow
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:8080/actuator/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s

  analytics-worker:
    image: "${analytics_image}"
    ports:
      - "8001:8001"
    networks:
      - tickonomics-net
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:8001/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  timescaledb:
    image: timescale/timescaledb:latest-pg16
    environment:
      POSTGRES_DB: tickonomics
      POSTGRES_USER: tickonomics
      POSTGRES_PASSWORD: "${postgres_password}"
    volumes:
      - /mnt/timescaledb:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U tickonomics"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - tickonomics-net

volumes:
  ingestion_overflow:

networks:
  tickonomics-net:
    driver: bridge
%{ endif }
COMPOSE_EOF

export TASK_ID="$(date +%Y%m%d-%H%M%S)"
export RESULTS_BUCKET="${results_bucket}"
export AWS_REGION="${aws_region}"
export AUTO_TERMINATE="${auto_terminate}"
export REGISTRY_URL="${registry_url}"
export BACKEND_IMAGE="${backend_image}"
export ANALYTICS_IMAGE="${analytics_image}"
export POSTGRES_PASSWORD="${postgres_password}"
export POLYGON_API_KEY="${polygon_api_key}"
export FRED_API_KEY="${fred_api_key}"

echo "=== Tickonomics Forecast Bootstrap ===" > /var/log/forecast-task.log
echo "TASK_ID=$TASK_ID" >> /var/log/forecast-task.log
echo "Starting at $(date)" >> /var/log/forecast-task.log

apt-get update -qq >> /var/log/forecast-task.log 2>&1
apt-get install -y -qq ca-certificates curl gnupg lsb-release awscli >> /var/log/forecast-task.log 2>&1

if ! command -v docker &>/dev/null; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq >> /var/log/forecast-task.log 2>&1
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin >> /var/log/forecast-task.log 2>&1
  systemctl start docker
  systemctl enable docker
fi

mkdir -p /mnt/timescaledb
DEVICE=$(lsblk -dnpo NAME,SIZE | grep -v "$(lsblk -npo NAME /dev/sda1 || echo /dev/sda)" | sort -k2 -h | tail -1 | awk '{print $1}')
if [ -n "$DEVICE" ] && ! mountpoint -q /mnt/timescaledb; then
  if ! blkid "$DEVICE" &>/dev/null; then
    mkfs.ext4 -F "$DEVICE" >> /var/log/forecast-task.log 2>&1
  fi
  mount "$DEVICE" /mnt/timescaledb
fi

if [ -n "$REGISTRY_URL" ]; then
  aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY_URL" >> /var/log/forecast-task.log 2>&1
  docker compose -f /opt/tickonomics/docker-compose.forecast.yml pull >> /var/log/forecast-task.log 2>&1
fi

docker compose -f /opt/tickonomics/docker-compose.forecast.yml up -d >> /var/log/forecast-task.log 2>&1

echo "Waiting for healthy services..." >> /var/log/forecast-task.log
for i in $(seq 1 60); do
  BACKEND=$(docker inspect --format='{{.State.Health.Status}}' forecast-backend-1 2>/dev/null || echo "missing")
  ANALYTICS=$(docker inspect --format='{{.State.Health.Status}}' forecast-analytics-worker-1 2>/dev/null || echo "missing")
  DB=$(docker inspect --format='{{.State.Health.Status}}' forecast-timescaledb-1 2>/dev/null || echo "missing")

  if [ "$BACKEND" = "healthy" ] && [ "$ANALYTICS" = "healthy" ] && [ "$DB" = "healthy" ]; then
    echo "All services healthy after ${i}0s" >> /var/log/forecast-task.log
    break
  fi
  sleep 10
done

echo "Waiting for data ingestion..." >> /var/log/forecast-task.log
for i in $(seq 1 40); do
  ROW_COUNT=$(docker exec forecast-timescaledb-1 psql -U tickonomics -t -c "SELECT COUNT(*) FROM rate_snapshots" 2>/dev/null | xargs || echo "0")
  echo "  rate_snapshots: ${ROW_COUNT} rows (${i}x15s)" >> /var/log/forecast-task.log
  if [ "$ROW_COUNT" -ge 50 ] 2>/dev/null; then
    echo "Ingestion threshold reached" >> /var/log/forecast-task.log
    break
  fi
  sleep 15
done

echo "Triggering computation pipeline..." >> /var/log/forecast-task.log
curl -sf -X POST http://localhost:8080/api/v1/kpis/compute --max-time 300 >> /var/log/forecast-task.log 2>&1 || true
curl -sf -X POST http://localhost:8080/api/v1/signals/generate --max-time 300 >> /var/log/forecast-task.log 2>&1 || true
curl -sf -X POST http://localhost:8001/api/v1/analytics/forecast --max-time 300 >> /var/log/forecast-task.log 2>&1 || true

echo "Collecting results..." >> /var/log/forecast-task.log
mkdir -p /opt/tickonomics/results
for endpoint in "kpis" "signals" "strategies" "backtest/results" "risk/summary" "regime" "liquidity"; do
  curl -sf --max-time 30 "http://localhost:8080/api/v1/${endpoint}" -o "/opt/tickonomics/results/${endpoint//\//-}.json" 2>/dev/null || true
done
for endpoint in "statistical/evt" "risk" "regime" "diagnostics"; do
  curl -sf --max-time 30 "http://localhost:8001/api/v1/${endpoint}" -o "/opt/tickonomics/results/analytics-${endpoint//\//-}.json" 2>/dev/null || true
done

docker exec forecast-timescaledb-1 pg_dump -U tickonomics tickonomics --no-owner --no-privileges --compress=9 > /opt/tickonomics/results/tickonomics_dump.sql.gz 2>/dev/null || true

tar -czf "/tmp/forecast-results-${TASK_ID}.tar.gz" -C /opt/tickonomics/results .

if [ -n "$RESULTS_BUCKET" ]; then
  aws s3 cp "/tmp/forecast-results-${TASK_ID}.tar.gz" "s3://${RESULTS_BUCKET}/${TASK_ID}/forecast-results.tar.gz" --region "$AWS_REGION" >> /var/log/forecast-task.log 2>&1
fi

echo "Uploading status marker..." >> /var/log/forecast-task.log
echo "COMPLETED" | aws s3 cp - "s3://${RESULTS_BUCKET}/${TASK_ID}/STATUS" --region "$AWS_REGION" >> /var/log/forecast-task.log 2>&1 || true

echo "Shutting down..." >> /var/log/forecast-task.log
docker compose -f /opt/tickonomics/docker-compose.forecast.yml down --timeout 60 >> /var/log/forecast-task.log 2>&1 || true
sync
if mountpoint -q /mnt/timescaledb; then
  umount /mnt/timescaledb >> /var/log/forecast-task.log 2>&1 || true
fi

if [ "$AUTO_TERMINATE" = "true" ]; then
  echo "Self-terminating..." >> /var/log/forecast-task.log
  TOKEN=$(curl -sf http://169.254.169.254/latest/api/token -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 60" 2>/dev/null || echo "")
  if [ -n "$TOKEN" ]; then
    INSTANCE_ID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null || echo "")
    if [ -n "$INSTANCE_ID" ]; then
      aws ec2 terminate-instances --instance-ids "$INSTANCE_ID" --region "$AWS_REGION" >> /var/log/forecast-task.log 2>&1 || true
    fi
  fi
fi
