#cloud-config
write_files:
  - path: /etc/tickonomics/config.env
    owner: root:root
    permissions: '0600'
    content: |
      REGISTRY_URL=${registry_url}
      BACKEND_IMAGE=${backend_image}
      ANALYTICS_IMAGE=${analytics_image}
      POSTGRES_PASSWORD=${postgres_password}
      POLYGON_API_KEY=${polygon_api_key}
      FRED_API_KEY=${fred_api_key}
      RESULTS_BUCKET=${results_bucket}
      AWS_REGION=${aws_region}
      AUTO_TERMINATE=${auto_terminate}
      RESULTS_DIR=/opt/tickonomics/results
      COMPOSE_FILE=/opt/tickonomics/docker-compose.forecast.yml

  - path: /opt/tickonomics/docker-compose.forecast.yml
    owner: root:root
    permissions: '0644'
    content: |
      services:
        backend:
          image: "${backend_image}"
          ports:
            - "8080:8080"
          environment:
            SPRING_DATASOURCE_URL: jdbc:postgresql://timescaledb:5432/tickonomics
            SPRING_DATASOURCE_USERNAME: tickonomics
            SPRING_DATASOURCE_PASSWORD: "${postgres_password}"
            ANALYTICS_WORKER_URL: http://analytics-worker:8001
            MANAGEMENT_OTLP_TRACING_ENDPOINT: ""
            MANAGEMENT_TRACING_SAMPLING_PROBABILITY: "0"
            POLYGON_API_KEY: "${polygon_api_key}"
            FRED_API_KEY: "${fred_api_key}"
            AUTH_DISABLED: "true"
            SERVER_SHUTDOWN: graceful
            SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE: 60s
          depends_on:
            timescaledb:
              condition: service_healthy
            analytics-worker:
              condition: service_healthy
          networks:
            - tickonomics-net
          volumes:
            - ingestion_overflow:/data/overflow
          healthcheck:
            test: ["CMD-SHELL", "curl -sf http://localhost:8080/actuator/health || exit 1"]
            interval: 10s
            timeout: 5s
            retries: 30
            start_period: 60s
        analytics-worker:
          image: "${analytics_image}"
          ports:
            - "8001:8001"
          networks:
            - tickonomics-net
          healthcheck:
            test: ["CMD-SHELL", "curl -sf http://localhost:8001/health || exit 1"]
            interval: 10s
            timeout: 5s
            retries: 10
            start_period: 30s
        timescaledb:
          image: timescale/timescaledb:latest-pg16
          environment:
            POSTGRES_DB: tickonomics
            POSTGRES_USER: tickonomics
            POSTGRES_PASSWORD: "${postgres_password}"
          volumes:
            - /mnt/timescaledb:/var/lib/postgresql/data
          healthcheck:
            test: ["CMD-SHELL", "pg_isready -U tickonomics"]
            interval: 5s
            timeout: 5s
            retries: 10
          networks:
            - tickonomics-net
      volumes:
        ingestion_overflow:
      networks:
        tickonomics-net:
          driver: bridge

runcmd:
  - mkdir -p /opt/tickonomics/scripts /opt/tickonomics/results /mnt/timescaledb
  - cp /opt/tickonomics/scripts/forecast-task.sh /opt/tickonomics/scripts/forecast-task.sh
  - chmod +x /opt/tickonomics/scripts/*.sh
  - bash /opt/tickonomics/scripts/forecast-task.sh
