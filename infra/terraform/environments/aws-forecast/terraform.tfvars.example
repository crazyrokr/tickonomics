# Tickonomics Forecast - AWS Environment Variables
# Copy to terraform.tfvars and fill in values

region                 = "us-east-1"
availability_zone      = "us-east-1a"
instance_type          = "c5.2xlarge"
spot_price_max         = "0.30"
db_volume_size_gb      = 50
image_tag              = "latest"
postgres_password      = "CHANGE_ME_STRONG_PASSWORD"
finnhub_api_key        = ""
alphavantage_api_key   = ""
fred_api_key           = ""
schedule_expression    = "cron(0 6 ? * MON-FRI *)"
auto_terminate         = true
results_retention_days = 30
alert_email            = "alerts@example.com"
name_prefix            = "tickonomics"

# Operator admin role (AssumeRole chaining for AWS CLI/Terraform). Empty = trust the whole
# account; set to your IAM user ARN(s) to narrow who can assume.
admin_trust_principals = []
