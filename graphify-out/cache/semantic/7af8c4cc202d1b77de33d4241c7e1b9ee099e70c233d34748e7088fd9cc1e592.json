{"nodes": [{"id": "plan_v5_00_dependency_graph_md_v5_dependency_graph", "label": "V5 Implementation Dependency Graph", "file_type": "document", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_00_dependency_graph_md_virtual_threads_primary", "label": "Virtual Threads Primary Runtime", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Virtual Threads + Spring MVC is the primary runtime. Shared service layer uses interfaces so WebFlux adapters can be added later as a separate module without rewriting business logic. No dual-mode parity requirement."}, {"id": "plan_v5_00_dependency_graph_md_arrow_ipc_for_sidecar", "label": "Arrow IPC for Sidecar Communication", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eliminates JSON serialization bottleneck for time-series arrays. Critical for AIC loop and batch analytics."}, {"id": "plan_v5_00_dependency_graph_md_direct_fred_nyfed_clients", "label": "Direct FRED/NY Fed Java Clients", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes OpenBB sidecar from the critical ILI ingestion path. OpenBB reserved for econometrics only."}, {"id": "plan_v5_00_dependency_graph_md_proxy_divergence_guard", "label": "Proxy Divergence Guard", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects T-Bill/SOFR dislocation during flight-to-quality events and suppresses stale proxy signals. Records 5-day rolling correlation and divergence score."}, {"id": "plan_v5_00_dependency_graph_md_dynamic_weighting_zero_variance", "label": "Dynamic Weighting for Zero-Variance Components", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redistributes weight among valid components instead of masking stale data as neutral (0.0). Zero-variance components return NaN so IliCalculator can apply dynamic redistribution."}, {"id": "plan_v5_00_dependency_graph_md_chronicle_queue_dedicated_storage", "label": "Chronicle Queue on Dedicated Storage", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tmpfs or separate NVMe partition prevents I/O contention with TimescaleDB."}, {"id": "plan_v5_00_dependency_graph_md_finos_cdm_subset", "label": "FINOS CDM Subset Adoption", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical instrument model for Repo, SOFR, T-Bill, equity. Reduces ad-hoc enum proliferation in API contracts and schema. Subset only \u2014 avoids full model boilerplate."}, {"id": "plan_v5_00_dependency_graph_md_perspective_adopt", "label": "FINOS Perspective for Data Grids", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-performance grid/chart for correlation matrix, signal log, liquidity heatmap. Complements D3.js. Adopted optionally for data-heavy panels."}, {"id": "plan_v5_00_dependency_graph_md_garch_regime_primary", "label": "GARCH Regime Engine as PRIMARY", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces K-means with conditional variance classification. Superior volatility regime detection. CNN-LSTM and QED as pluggable alternatives."}, {"id": "plan_v5_00_dependency_graph_md_bayesian_optimizer_primary", "label": "Bayesian Weight Optimizer PRIMARY", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed-loop weight optimization with 3 profiles (Profit Maximizer, Throughput Maximizer, Regime Adaptor). Validation pipeline and auto-deployment."}, {"id": "plan_v5_00_dependency_graph_md_multi_dimensional_parameter_scanning", "label": "Multi-Dimensional Parameter Scanning", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grid/Sobol search across ILI weights, percentile thresholds, and cooldown. Prevents overfitting to single optimum."}, {"id": "plan_v5_00_dependency_graph_md_aumf_five_stage_framework", "label": "AUMF Five-Stage Uncertainty Management", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenario-based signal suppression, ethical boundary filters, AUMF status integration. Five stages: categorize, identify, create scenarios, best practices, design response."}, {"id": "plan_v5_00_dependency_graph_md_finbert_sentiment_adopt", "label": "FinBERT Sentiment Intelligence", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contextual Fed sentiment analysis. Hawkish/dovish detection complements quantitative FRED data. SSRN-4995172."}, {"id": "plan_v5_00_dependency_graph_md_online_learning_regret_minimization", "label": "Online Learning / Regret Minimization", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AgnosticAggregator using exponential weights. Mathematically rigorous, no GPU needed. Walk-forward validation. SSRN-5242085."}, {"id": "plan_v5_00_dependency_graph_md_11_implementation_tracks", "label": "11 Parallel Implementation Tracks", "file_type": "concept", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_00_dependency_graph_md_consolidated_proposals_v4_v5", "label": "12 Consolidated Proposals (v4-v5)", "file_type": "concept", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_00_dependency_graph_md_markov_optimal_stops", "label": "Markov-Modulated Optimal Stops", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State-dependent stops replace static stop-loss/take-profit in PaperTradingEngine. SSRN-2381830. Adopted in Phase 2."}, {"id": "plan_v5_00_dependency_graph_md_leverage_rotation_strategy", "label": "Leverage Rotation Strategy", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200-day MA rotation between leveraged equity and risk-free assets. Simple, well-tested tail-risk truncation. SSRN-2741701."}, {"id": "plan_v5_00_dependency_graph_md_pairs_trading_verification", "label": "Pairs Trading Verification", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orthogonal cross-validation of ILI signals via minimum-distance pairs. Divergence detection between funding liquidity and relative value. SSRN-141615."}, {"id": "plan_v5_00_dependency_graph_md_big_red_button_kill_switch", "label": "Big Red Button Kill-Switch", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual kill-switch with < 50ms latency. Halts all algorithmic trading. Requires explicit manual acknowledgment for recovery."}, {"id": "plan_v5_00_dependency_graph_md_phantom_liquidity_detection", "label": "Phantom Liquidity Detection", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PLI comparing canceled vs. executed volume. Discounts ILI for unreliable depth."}, {"id": "plan_v5_00_dependency_graph_md_behavioural_liquidity_guard", "label": "Behavioural Liquidity Guard", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BRI from OFI, spread volatility, sentiment polarity. Herding filter and panic guard. 5th axis on systemic risk heatmap."}, {"id": "plan_v5_00_dependency_graph_md_ml_reproducibility_scoring", "label": "ML Reproducibility Scoring (RDS)", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0-2 rubric for disclosure quality. Audit-grade artifacts for regulator-defensible deployment."}, {"id": "plan_v5_00_dependency_graph_md_global_safe_mode", "label": "Global Safe Mode", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System-wide safe mode triggered by correlated degradation. Throttles ingestion, stops signals, halts execution. Circuit breaker of last resort."}, {"id": "plan_v5_00_dependency_graph_md_regulatory_algorithm_testing", "label": "Regulatory Algorithm Behavioral Testing", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MiFID II-style SMC scenarios, OTR monitoring, circuit breaker, kill-switch verification, self-certification report."}, {"id": "plan_v5_00_dependency_graph_md_q_world_risk_premium_residual", "label": "Q-World Risk-Premium Residual Monitor", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates ProxyDivergenceGuard DISLOCATED status independently. CIR model for fair-value T-Bill yield. SSRN-1717163."}, {"id": "plan_v5_00_dependency_graph_md_greeks_nomenclature_standardization", "label": "Standardized Greeks Nomenclature", "file_type": "rationale", "source_file": "docs/plan_v5/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardized nomenclature for existing KPIs: Repo-Delta, Rate-Delta, Rate-Gamma, Spread-Delta, Volga. Sensitivity-adjusted signal thresholds."}, {"id": "plan_v5_00_depe