{"nodes": [{"id": "plan_v5_garch_regime_engine", "label": "GARCH Regime Engine (PRIMARY)", "file_type": "concept", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_virtual_threads_primary", "label": "Virtual Threads + Spring MVC (Primary Runtime)", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Virtual Threads + MVC is the primary runtime. Shared service layer uses interfaces so WebFlux adapters can be added later as a separate module without rewriting business logic. No dual-mode parity requirement."}, {"id": "plan_v5_direct_fred_nyfed_clients", "label": "Direct FRED/NY Fed Java HTTP Clients", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core ILI data sources fetched via direct lightweight Java HTTP clients \u2014 no OpenBB dependency on the critical ingestion path. All data sources are free (FRED, NY Fed, Yahoo Finance, Finnhub, Alpha Vantage, DataHub, Ken French). Zero recurring data costs."}, {"id": "plan_v5_proxy_divergence_guard", "label": "Proxy Divergence Guard", "file_type": "concept", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_dynamic_weighting", "label": "Dynamic Weighting (Zero-Variance NaN Redistribution)", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-variance component z-score returns NaN (not 0.0). Weight redistributed proportionally among valid components instead of masking stale data as neutral (0.0). ILI status set to DEGRADED_COMPONENT_STALE."}, {"id": "plan_v5_cdm_adapter_layer", "label": "CDM Adapter Layer (Proposal #5)", "file_type": "concept", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_finos_cdm_subset", "label": "FINOS CDM Subset Projection", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a CDM projection for instrument type standardization in API contracts and database schema. Adopt only the instrument types consumed by tickonomics (Repo, SOFR, T-Bill, equity). Avoid full model adoption \u2014 limits complexity and boilerplate."}, {"id": "plan_v5_dependency_graph_document", "label": "Implementation Dependency Graph (plan v6)", "file_type": "document", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_free_data_source_migration_v6", "label": "v6 Free Data Source Migration", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero recurring data costs for development and demo deployment. All paid data sources (Polygon, OpenBB) replaced with free alternatives (Yahoo Finance, Finnhub, Alpha Vantage, DataHub, Ken French, Fed RSS). No OpenBB sidecar dependency."}, {"id": "plan_v5_precomputed_kpi_views", "label": "Pre-Computed KPI Views (TimescaleDB Continuous Aggregates)", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rolling correlation and beta pre-computed as TimescaleDB continuous aggregates using user-defined aggregates. Reduces per-cycle TA-Lib computation load for stable-window KPIs."}, {"id": "plan_v5_wait_free_ingestion", "label": "Wait-Free Ingestion (Off-Heap, Zero-GC Buffer)", "file_type": "rationale", "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TimescaleDbWriter uses off-heap, GC-friendly buffer patterns. Chronicle Queue configured for memory-mapped files on dedicated NVMe partition. Prevents GC-induced latency spikes during market events."}], "edges": [{"source": "plan_v5_timescaledb_writer", "target": "plan_v5_wait_free_ingestion", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "weight": 1.0}, {"source": "plan_v5_garch_regime_engine", "target": "plan_v5_vansteenberghe_lecture_notes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "weight": 1.0}, {"source": "plan_v5_direct_fred_nyfed_clients", "target": "plan_v5_openbb_client", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "weight": 1.0}, {"source": "plan_v5_track_1_scaffolding", "target": "plan_v5_track_2_database", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location": null, "weight": 1.0}, {"source": "plan_v5_track_2_database", "target": "plan_v5_track_4_ingestion", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v6/00-dependency-graph.md", "source_location"