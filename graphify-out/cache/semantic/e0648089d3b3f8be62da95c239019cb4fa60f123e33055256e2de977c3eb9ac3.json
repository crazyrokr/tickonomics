{"nodes": [{"id": "plan_v5_02_database_schema_md_database_schema_v5", "label": "Track 2: Database Schema TimescaleDB (v5)", "file_type": "document", "source_file": "docs/plan_v5/02-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v5_02_database_schema_md_timescaledb_single_database", "label": "TimescaleDB Single Database Architecture", "file_type": "rationale", "source_file": "docs/plan_v5/02-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single TimescaleDB instance handles both time-series (hypertables) and relational data (regular PostgreSQL tables). Replaces v5 dual-database architecture. Schema migrations use Flyway only."}, {"id": "plan_v5_02_database_schema_md_real_time_aggregates", "label": "Real-Time Aggregates (materialized_only=false)", "file_type": "rationale", "source_file": "docs/plan_v5/02-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Continuous aggregates use materialized_only=false so that TimescaleDB transparently joins materialized historical data with raw tick_data, providing true real-time OHLCV without a 1-minute blind spot."}], "edges": [{"source": "plan_v5_02_database_schema_md_timescaledb_single_database", "target": "plan_v5_02_database_schema_md_database_schema_v5", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v5/02-database-schema.md", "source_location": null, "weight": 1.0}, {"source": "plan_v5_02_database_schema_md_real_time_aggregates", "target": "plan_v5_02_database_schema_md_database_schema_v5", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/plan_v5/02-database-schema.md", "source_location": null, "weight": 1.0}], "hyperedges": []}